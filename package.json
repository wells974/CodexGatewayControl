{
  "name": "codex-gateway-control",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "description": "Codex 本地 Gateway 管理工具",
  "author": "wells974",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:controller\" \"npm:dev:web\"",
    "dev:controller": "tsx watch src/controller/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.json && vite build",
    "build:runtime": "npm run build && node scripts/build-runtime.mjs",
    "start": "node dist-controller/controller/index.js",
    "desktop:dev": "npm run build:runtime && electron .",
    "package:win": "npm run build:runtime && node scripts/fetch-node-runtime.mjs --target win-x64 && electron-builder --win nsis --x64 --publish never",
    "package:mac:intel": "npm run build:runtime && node scripts/fetch-node-runtime.mjs --target mac-x64 && electron-builder --mac dmg --x64 --publish never",
    "package:mac:arm64": "npm run build:runtime && node scripts/fetch-node-runtime.mjs --target mac-arm64 && electron-builder --mac dmg --arm64 --publish never",
    "package:all": "npm run package:win && npm run package:mac:intel && npm run package:mac:arm64",
    "gateway": "npm start",
    "test": "tsx --test src/controller/*.test.ts"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "lucide-react": "^1.28.0",
    "radix-ui": "^1.6.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "ws": "^8.18.1"
  },
  "build": {
    "appId": "com.codex.gatewaycontrol",
    "productName": "Codex Gateway Control",
    "asar": true,
    "directories": { "output": "release" },
    "files": ["desktop/**", "!node_modules/**"],
    "extraResources": [
      { "from": "dist-runtime", "to": "gateway-runtime" },
      { "from": "packaging/node-runtime", "to": "node-runtime" }
    ],
    "win": {
      "icon": "desktop/assets/cgc-app-icon.ico",
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "CodexGatewayControl-${version}-win-${arch}.${ext}"
    },
    "mac": {
      "icon": "desktop/assets/cgc-app-icon.icns",
      "extendInfo": {
        "LSUIElement": true
      },
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }],
      "artifactName": "CodexGatewayControl-${version}-mac-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.3"
  }
}
