# 仅供本地 Gateway 使用。不要将这些值放入 React 应用。
GATEWAY_PORT=4000
CONTROLLER_HOST=127.0.0.1
# 仅供 Codex 内嵌管理页使用的本地 HTTPS 端口；模型代理仍使用上面的 4000。
GATEWAY_UI_TLS_PORT=4401
GATEWAY_ACCESS_TOKEN=replace-with-a-long-local-secret

# 仅用于通过安全的 HttpOnly Cookie 验证浏览器写请求。
CONTROLLER_REQUEST_TOKEN=replace-with-another-long-local-secret

# npm run codex 使用的专用 loopback CDP 起始端口；占用时会自动递增，不会修改现有 Codex 窗口。
CODEX_CDP_PORT=9237
# 独立 Codex 窗口的持久用户数据目录。首次使用需要在该窗口登录一次。
CODEX_CDP_USER_DATA_DIR=.data/codex-cdp-profile
# Windows 若 ChatGPT 不在默认安装目录，可填写 ChatGPT.exe 的绝对路径；macOS 可填写 .app 路径。
# CODEX_APP_PATH=C:\\Users\\你的用户名\\AppData\\Local\\Programs\\ChatGPT\\ChatGPT.exe
