# Local Gateway only. Do not put these values in the React app.
GATEWAY_PORT=4000
CONTROLLER_HOST=127.0.0.1
GATEWAY_ACCESS_TOKEN=replace-with-a-long-local-secret

# Used only to authenticate browser write requests as a secure HttpOnly cookie.
CONTROLLER_REQUEST_TOKEN=replace-with-another-long-local-secret

# Dedicated loopback CDP port used by npm run codex. Existing Codex windows stay untouched.
CODEX_CDP_PORT=9237
