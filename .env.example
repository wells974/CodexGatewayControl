# 仅供本地 Gateway 使用。不要将这些值放入 React 应用。
GATEWAY_PORT=4000
CONTROLLER_HOST=127.0.0.1
GATEWAY_ACCESS_TOKEN=replace-with-a-long-local-secret

# 仅用于通过安全的 HttpOnly Cookie 验证浏览器写请求。
CONTROLLER_REQUEST_TOKEN=replace-with-another-long-local-secret

# npm run codex 使用的专用 loopback CDP 端口，不会修改现有 Codex 窗口。
CODEX_CDP_PORT=9237
